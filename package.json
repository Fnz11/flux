{
  "name": "flux",
  "private": true,
  "scripts": {
    "dev": "docker compose up -d",
    "seed": "cd backend && DIRECT_DATABASE_URL=\"${DIRECT_DATABASE_URL:-postgres://postgres:postgres@localhost:5433/flux?sslmode=disable}\" go run cmd/seed/main.go",
    "seed:clean": "cd backend && DIRECT_DATABASE_URL=\"${DIRECT_DATABASE_URL:-postgres://postgres:postgres@localhost:5433/flux?sslmode=disable}\" go run cmd/seed/main.go --clean",
    "seed:wallet": "cd backend && DIRECT_DATABASE_URL=\"${DIRECT_DATABASE_URL:-postgres://postgres:postgres@localhost:5433/flux?sslmode=disable}\" go run cmd/seed/main.go",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "npm run lint --prefix frontend"
    ],
    "backend/**/*.go": [
      "gofmt -w"
    ]
  }
}
