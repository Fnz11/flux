# Flux backend — environment template
#
# Topology note:
#   DATABASE_URL points at PgBouncer (6432) for transaction-pooled API queries.
#   DIRECT_DATABASE_URL points straight at TimescaleDB (5432) for DDL / Hypertable migrations.

PORT=8080
ENV=development

# Core API DB via PgBouncer (transaction pooling)
DATABASE_URL=postgres://postgres:postgres@localhost:6432/flux?sslmode=disable

# Direct DB connection (for GORM AutoMigrate, seeding, and hypertable creation on startup)
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5433/flux?sslmode=disable

REDIS_URL=redis://localhost:6379

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_PROGRAM_ID=11111111111111111111111111111111

JWT_SECRET=change-me-to-at-least-32-bytes-long-secret-key!
CORS_ORIGIN=http://localhost:3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flux
