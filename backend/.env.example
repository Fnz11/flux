# FBYT-Clone backend — environment template
# Copy to .env and adjust:  cp .env.example .env

# --- App -----------------------------------------------------------------
PORT=8080
GIN_MODE=debug
JWT_SECRET=change-me-to-a-long-random-string
ENABLE_PPROF=false
DUST_THRESHOLD=0.001
FOCUS_ASSETS_WHITELIST=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Database routing ----------------------------------------------------
# Runtime API connections: route THROUGH PgBouncer (transaction pool, 6432).
# This is what DATABASE_URL in config.go reads. Keep the two URLs in sync.
DATABASE_URL=postgres://postgres:postgres@localhost:6432/fbyt?sslmode=disable
# DDL / migrations / EXPLAIN ANALYZE / maintenance: connect DIRECT to
# TimescaleDB (5432). Never run migrations through PgBouncer.
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fbyt?sslmode=disable
# If pgx prepared statements fail through the pool, append:
#   ?default_query_exec_mode=simple_protocol
# to DATABASE_URL (PgBouncer 1.17+ handles named prepared statements in
# transaction mode, so this should not be needed).

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- TimescaleDB / Postgres ----------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fbyt
POSTGRES_PORT=5432

# --- PgBouncer -----------------------------------------------------------
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20

# --- Redis server --------------------------------------------------------
REDIS_PORT=6379

# --- TimescaleDB ---------------------------------------------------------
# License GUC set in docker-compose (timescaledb.license=timescale).
TIMESCALEDB_TELEMETRY=off
